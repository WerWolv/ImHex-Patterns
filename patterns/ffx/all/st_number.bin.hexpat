u32 start_offset @ 0x10 [[hidden]];
u16 max_idx @ 0x0A [[hidden]];
u16 data_size @ 0x0E [[hidden]];
u32 strings_offset = start_offset + data_size;
Block blocks[max_idx + 1] @ start_offset;