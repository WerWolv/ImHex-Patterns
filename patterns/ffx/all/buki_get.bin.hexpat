    MagicDefense10,
    MagicDefense20,
    Hp5,
    Hp10,
    Hp20,
    Hp30,
    Mp5,
    Mp10,
    Mp20,
    Mp30,
    Capture,
    AeonImmunities,
    DistillPower,
    DistillMana,
    DistillSpeed,
    DistillAbility,
    Ribbon,
};

bitfield GearProps {
    flag1 : 1;
    hidden : 1;
    no_kaizou : 1;
    brotherhood : 1;
    padding : 4;
};

struct Gear {
    GearProps properties;
    u8 owner;
    GearType type;
    u8;
    u8 dmg_formula;
    u8 power;
    u8 crit_bonus; 
    u8 slot_count;
    GearAbilities abilities[4];
};

u16 max_idx @ 0xA [[hidden]];
u32 start_offset @ 0x10 [[hidden]];
Gear gear[max_idx + 1] @ start_offset;