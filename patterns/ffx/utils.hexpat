#include <std/string.pat>

fn ffx2ascii(ref auto s) {
    for (u32 i = 0, i < std::string::length(s), i = i + 1) {
        char c;
        match(s[i]) {
            (0x03): c = '\n';
            (0x12): c = '%';
            (0x30): c = '0';
            (0x31): c = '1';
            (0x32): c = '2';
            (0x33): c = '3';
            (0x34): c = '4';
            (0x35): c = '5';
            (0x36): c = '6';
            (0x37): c = '7';
            (0x38): c = '8';
            (0x39): c = '9';
            (0x3A): c = ' ';
            (0x3B): c = '!';
            (0x3C): c = '"';
            (0x3D): c = '#';
            (0x3E): c = '$';
            (0x3F): c = '%';
            (0x40): c = '&';
            (0x41): c = ''';
            (0x42): c = '(';
            (0x43): c = ')';
            (0x44): c = '*';
            (0x45): c = '+';
            (0x46): c = ',';
            (0x47): c = '-';
            (0x48): c = '.';
            (0x49): c = '/';
            (0x4A): c = ':';
            (0x4B): c = ';';
            (0x4C): c = '<';
            (0x4D): c = '=';
            (0x4E): c = '>';
            (0x4F): c = '?';
            (0x50): c = 'A';
            (0x51): c = 'B';
            (0x52): c = 'C';
            (0x53): c = 'D';
            (0x54): c = 'E';
            (0x55): c = 'F';
            (0x56): c = 'G';
            (0x57): c = 'H';
            (0x58): c = 'I';
            (0x59): c = 'J';
            (0x5A): c = 'K';
            (0x5B): c = 'L';
            (0x5C): c = 'M';
            (0x5D): c = 'N';
            (0x5E): c = 'O';
            (0x5F): c = 'P';
            (0x60): c = 'Q';
            (0x61): c = 'R';
            (0x62): c = 'S';
            (0x63): c = 'T';
            (0x64): c = 'U';
            (0x65): c = 'V';
            (0x66): c = 'W';
            (0x67): c = 'X';
            (0x68): c = 'Y';
            (0x69): c = 'Z';
            (0x6A): c = '[';
            (0x6B): c = '\\';
            (0x6C): c = ']';
            (0x6D): c = '^';
            (0x6E): c = '_';
            (0x6F): c = "‘";
            (0x70): c = 'a';
            (0x71): c = 'b';
            (0x72): c = 'c';
            (0x73): c = 'd';
            (0x74): c = 'e';
            (0x75): c = 'f';
            (0x76): c = 'g';
            (0x77): c = 'h';
            (0x78): c = 'i';
            (0x79): c = 'j';
            (0x7A): c = 'k';
            (0x7B): c = 'l';
            (0x7C): c = 'm';
            (0x7D): c = 'n';
            (0x7E): c = 'o';
            (0x7F): c = 'p';
            (0x80): c = 'q';
            (0x81): c = 'r';
            (0x82): c = 's';
            (0x83): c = 't';
            (0x84): c = 'u';
            (0x85): c = 'v';
            (0x86): c = 'w';
            (0x87): c = 'x';
            (0x88): c = 'y';
            (0x89): c = 'z';
            (0x8A): c = '{';
            (0x8B): c = '|';
            (0x8C): c = '}';
            (0x8D): c = '~';
            (0xD0): c = ',';
            (0xD4): c = '\'';
            (0xD7): c = '-';
            (0xD8): c = '~';
            (0xDA): c = ' ';
            (_): c = 0xB1;
        }
        
        s[i] = c;
    }
    
    return s;
};

fn ffx2en(ref auto s) {
    return ffx2ascii(s);
};

