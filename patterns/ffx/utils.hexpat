struct String0 {
    u16 offset;
    u16;
    char text[while($[$] !=  0x00)] @ data_end_offset + offset [[format("ffx2ascii")]];
} [[format("format_string_en")]];

struct String0Jp {
    u16 offset;
    u16;
    char text[while($[$] !=  0x00)] @ data_end_offset + offset [[format("ffx2jp")]];
} [[format("format_string_jp")]];

struct String {
    u16 offset;
    u16 hira_offset;
    char text[while($[$] != 0x00)] @ data_end_offset + offset [[format("ffx2ascii")]];
    char hira[while($[$] != 0x00)] @ data_end_offset + hira_offset [[format("ffx2ascii")]];
} [[format("format_string_en")]];

struct StringJp {
    u16 offset;
    u16 hira_offset;
    char text[while($[$] != 0x00)] @ data_end_offset + offset [[format("ffx2jp")]];
    char hira[while($[$] != 0x00)] @ data_end_offset + hira_offset [[format("ffx2jp")]];
} [[format("format_string_jp")]];

struct String2 {
    u16 offset;
    u16;
    u16 hira_offset;
    u16;
    char text[while($[$] != 0x00)] @ data_end_offset + offset [[format("ffx2ascii")]];
    char hira[while($[$] != 0x00)] @ data_end_offset + hira_offset;
} [[format("format_string_en")]];

struct String2Jp {
    u16 offset;
    u16;
    u16 hira_offset;
    u16;
    char text[while($[$] != 0x00)] @ data_end_offset + offset [[format("ffx2jp")]];
    char hira[while($[$] != 0x00)] @ data_end_offset + hira_offset [[format("ffx2jp")]];
} [[format("format_string_jp")]];

fn format_string_en(ref String s) {
    return ffx2ascii(s.text);
};

fn format_string_jp(ref StringJp s) {
    return ffx2jp(s.text);
};

u32 start_offset @ 0x10 [[hidden]];
u16 min_idx @ 0x08 [[hidden]];
u16 max_idx @ 0x0A [[hidden]];
u16 block_size @ 0x0C [[hidden]];
u16 block_count = max_idx - min_idx + 1;
u32 data_end_offset = start_offset + block_count * block_size;